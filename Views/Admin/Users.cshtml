@model HotelRoomsWeb.Models.AdminUsersViewModel

@{
    ViewData["Title"] = "Admin users";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mt-3 mb-3 page-toolbar">
    <div>
        <h2 class="mb-1">Admin users</h2>
        <div class="page-subtitle">Add users and manage who can change vacant room status</div>
    </div>
    <a asp-controller="Rooms" asp-action="Index" class="btn btn-outline-secondary mobile-full-btn">Rooms list</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card filters-card mb-3">
    <div class="card-header bg-white fw-semibold">Add new user</div>
    <div class="card-body">
        <form asp-controller="Admin" asp-action="CreateUser" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label asp-for="NewUser.UserName" class="form-label"></label>
                    <input asp-for="NewUser.UserName" name="UserName" class="form-control" autocomplete="off" />
                    <span asp-validation-for="NewUser.UserName" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="NewUser.Password" class="form-label"></label>
                    <input asp-for="NewUser.Password" name="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewUser.Password" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-4">
                    <div class="d-flex flex-column gap-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="new-is-active" />
                            <input type="hidden" name="IsActive" value="false" />
                            <label class="form-check-label" for="new-is-active">Active</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="CanChangeRoomStatus" value="true" id="new-can-change" />
                            <input type="hidden" name="CanChangeRoomStatus" value="false" />
                            <label class="form-check-label" for="new-can-change">Can change room status</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="IsAdmin" value="true" id="new-is-admin" />
                            <input type="hidden" name="IsAdmin" value="false" />
                            <label class="form-check-label" for="new-is-admin">Admin</label>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Add user</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Active</th>
                    <th>Can change room status</th>
                    <th>Admin</th>
                    <th>Created</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td class="fw-semibold">@user.UserName</td>
                        <td>
                            <form asp-controller="Admin" asp-action="UpdateUserPermissions" method="post" class="d-flex flex-wrap align-items-center gap-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <input type="hidden" name="isActive" value="false" />
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" name="isActive" value="true" id="active-@user.Id" checked="@user.IsActive" />
                                    <label class="form-check-label" for="active-@user.Id">Active</label>
                                </div>
                        </td>
                        <td>
                                <input type="hidden" name="canChangeRoomStatus" value="false" />
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" name="canChangeRoomStatus" value="true" id="change-@user.Id" checked="@user.CanChangeRoomStatus" />
                                    <label class="form-check-label" for="change-@user.Id">Allowed</label>
                                </div>
                        </td>
                        <td>
                                <input type="hidden" name="isAdmin" value="false" />
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" name="isAdmin" value="true" id="admin-@user.Id" checked="@user.IsAdmin" />
                                    <label class="form-check-label" for="admin-@user.Id">Admin</label>
                                </div>
                        </td>
                        <td class="text-muted small">@user.CreatedAt</td>
                        <td>
                                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
