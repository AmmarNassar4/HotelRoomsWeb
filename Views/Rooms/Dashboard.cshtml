@model HotelRoomsWeb.Models.RoomDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
    var roomsJson = JsonSerializer.Serialize(Model.Rooms, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mt-3 mb-3 page-toolbar">
    <div>
        <h2 class="mb-1">Dashboard</h2>
        <div class="page-subtitle">Charts and summary from the latest room data</div>
    </div>
    <div class="d-grid d-md-flex gap-2">
        <button id="btn-refresh-dashboard" type="button" class="btn btn-primary mobile-full-btn">Refresh data</button>
        <a asp-controller="Rooms" asp-action="Index" class="btn btn-outline-secondary mobile-full-btn">Rooms list</a>
    </div>
</div>

<div class="refresh-status text-muted small mb-2" id="dashboardRefreshStatus"></div>

<div class="card filters-card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label class="form-label">Occupancy status</label>
                <select id="f-occupancy" class="form-select">
                    <option value="">All</option>
                    <option value="Occupied">Occupied</option>
                    <option value="Vacant">Vacant</option>
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Room status</label>
                <select id="f-roomstatus" class="form-select">
                    <option value="">All</option>
                    <option value="Clean">Clean</option>
                    <option value="Dirty">Dirty</option>
                    <option value="Clean (Inspected)">Clean (Inspected)</option>
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Room type</label>
                <select id="f-roomtype" class="form-select">
                    <option value="">All</option>
                </select>
            </div>
        </div>
        <div class="d-grid d-md-flex mt-3 gap-2 align-items-center">
            <button id="btn-reset" type="button" class="btn btn-sm btn-outline-secondary">Reset filters</button>
            <span class="text-muted small">Last updated: <span id="dashboardLastUpdated">—</span></span>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="kpi-card text-center">
            <div class="kpi-number" id="kpi-total">0</div>
            <div class="text-muted">Total rooms</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card text-center">
            <div class="kpi-number" id="kpi-occupied">0</div>
            <div class="text-muted">Occupied</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card text-center">
            <div class="kpi-number" id="kpi-vacant">0</div>
            <div class="text-muted">Vacant</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card text-center">
            <div class="kpi-number" id="kpi-dirty">0</div>
            <div class="text-muted">Dirty</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-lg-6">
        <div class="card dashboard-card">
            <div class="card-header bg-white fw-semibold">Room status distribution</div>
            <div class="card-body chart-wrap">
                <canvas id="chartStatus" height="220"></canvas>
                <small class="text-muted d-block mt-2">
                    Click a slice to see the room type breakdown in the chart on the right.
                </small>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card dashboard-card">
            <div class="card-header bg-white fw-semibold">
                <span id="chart2-title">Detailed by room type</span>
            </div>
            <div class="card-body chart-wrap">
                <canvas id="chartStatusByType" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const dataUrl = '@Url.Action("Data", "Rooms")';
        let rooms = (@Html.Raw(roomsJson)).map(normalizeRoom);

        const $occ = document.getElementById('f-occupancy');
        const $rs = document.getElementById('f-roomstatus');
        const $rt = document.getElementById('f-roomtype');
        const $chart2Title = document.getElementById('chart2-title');
        const refreshButton = document.getElementById('btn-refresh-dashboard');
        const refreshStatus = document.getElementById('dashboardRefreshStatus');
        const lastUpdated = document.getElementById('dashboardLastUpdated');

        let statusChart, detailedChart;

        function normalizeRoom(room) {
            return {
                roomNumber: room.roomNumber ?? room.RoomNumber ?? 0,
                roomType: room.roomType ?? room.RoomType ?? '',
                occupancyStatus: room.occupancyStatus ?? room.OccupancyStatus ?? '',
                roomStatus: room.roomStatus ?? room.RoomStatus ?? '',
                guestName: room.guestName ?? room.GuestName ?? ''
            };
        }

        function setLastUpdated() {
            lastUpdated.textContent = new Date().toLocaleString();
        }

        function getChartAspectRatio() {
            return window.matchMedia('(max-width: 767.98px)').matches ? 1.2 : 1.75;
        }

        function populateRoomTypes() {
            const selected = $rt.value;
            const types = Array.from(new Set(rooms.map(r => (r.roomType || '').trim()).filter(Boolean))).sort();
            $rt.innerHTML = '<option value="">All</option>';
            types.forEach(type => {
                const option = document.createElement('option');
                option.value = type;
                option.textContent = type;
                $rt.appendChild(option);
            });
            if (types.includes(selected)) {
                $rt.value = selected;
            }
        }

        function applyFilters(data) {
            return data.filter(r =>
                (!$occ.value || r.occupancyStatus === $occ.value) &&
                (!$rs.value || r.roomStatus === $rs.value) &&
                (!$rt.value || r.roomType === $rt.value)
            );
        }

        function summarize(data) {
            const byStatus = {};
            const byTypeWithin = {};
            let occupied = 0, vacant = 0, dirty = 0;

            data.forEach(r => {
                const roomStatus = r.roomStatus || 'Unknown';
                byStatus[roomStatus] = (byStatus[roomStatus] || 0) + 1;

                if (r.roomStatus === 'Dirty') dirty++;
                if (r.occupancyStatus === 'Occupied') {
                    occupied++;
                } else if (r.occupancyStatus === 'Vacant') {
                    vacant++;
                }

                const keyType = (r.roomType || 'Not specified');
                const bucket = byTypeWithin[roomStatus] = byTypeWithin[roomStatus] || {};
                bucket[keyType] = (bucket[keyType] || 0) + 1;
            });

            return { byStatus, byTypeWithin, occupied, vacant, total: data.length, dirty };
        }

        function labelsAndValues(dict) {
            const labels = Object.keys(dict);
            const values = labels.map(k => dict[k]);
            return { labels, values };
        }

        function render() {
            const data = applyFilters(rooms);
            const { byStatus, byTypeWithin, occupied, vacant, total, dirty } = summarize(data);

            document.getElementById('kpi-total').innerText = total;
            document.getElementById('kpi-occupied').innerText = occupied;
            document.getElementById('kpi-vacant').innerText = vacant;
            document.getElementById('kpi-dirty').innerText = dirty;

            const ctx1 = document.getElementById('chartStatus').getContext('2d');
            const s1 = labelsAndValues(byStatus);

            if (statusChart) statusChart.destroy();
            statusChart = new Chart(ctx1, {
                type: 'pie',
                data: {
                    labels: s1.labels,
                    datasets: [{ data: s1.values }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    aspectRatio: getChartAspectRatio(),
                    onClick: (evt, elements) => {
                        if (!elements.length) return;
                        const label = statusChart.data.labels[elements[0].index];
                        renderDrilldown(label, byTypeWithin[label] || {});
                    },
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            const firstStatus = s1.labels[0] || '';
            renderDrilldown(firstStatus, byTypeWithin[firstStatus] || {});
        }

        function renderDrilldown(statusLabel, dict) {
            const ctx2 = document.getElementById('chartStatusByType').getContext('2d');
            const s2 = labelsAndValues(dict);

            if (detailedChart) detailedChart.destroy();
            detailedChart = new Chart(ctx2, {
                type: 'pie',
                data: {
                    labels: s2.labels,
                    datasets: [{ data: s2.values }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    aspectRatio: getChartAspectRatio(),
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            $chart2Title.innerText = statusLabel
                ? `Detailed for status "${statusLabel}" by room type`
                : 'Detailed by room type';
        }

        async function refreshDashboard() {
            refreshButton.disabled = true;
            refreshStatus.className = 'refresh-status text-muted small mb-2';
            refreshStatus.textContent = 'Updating data...';

            try {
                const response = await fetch(`${dataUrl}?ts=${Date.now()}`, {
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    cache: 'no-store',
                    credentials: 'same-origin'
                });

                if (response.redirected) {
                    window.location.href = response.url;
                    return;
                }

                if (response.status === 401) {
                    refreshStatus.className = 'refresh-status text-danger small mb-2';
                    refreshStatus.textContent = 'Your session expired. Please log in again.';
                    return;
                }

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                rooms = (await response.json()).map(normalizeRoom);
                populateRoomTypes();
                render();
                setLastUpdated();
                refreshStatus.className = 'refresh-status text-success small mb-2';
                refreshStatus.textContent = 'Data updated successfully.';
                window.setTimeout(() => refreshStatus.textContent = '', 3000);
            } catch (err) {
                refreshStatus.className = 'refresh-status text-danger small mb-2';
                refreshStatus.textContent = 'Could not refresh data. Please try again.';
            } finally {
                refreshButton.disabled = false;
            }
        }

        $occ.addEventListener('change', render);
        $rs.addEventListener('change', render);
        $rt.addEventListener('change', render);
        refreshButton.addEventListener('click', refreshDashboard);

        document.getElementById('btn-reset').addEventListener('click', () => {
            $occ.value = '';
            $rs.value = '';
            $rt.value = '';
            render();
        });

        populateRoomTypes();
        render();
        setLastUpdated();
    </script>
}
