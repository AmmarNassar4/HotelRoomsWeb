@model IEnumerable<HotelRoomsWeb.Models.RoomGuestViewModel>

@{
    ViewData["Title"] = "Rooms status";

    // Build distinct list of room types for the Type combobox
    var roomTypes = Model
        .Select(m => m.RoomType)
        .Where(t => !string.IsNullOrWhiteSpace(t))
        .Distinct()
        .OrderBy(t => t)
        .ToList();
}

<div class="d-flex align-items-center justify-content-between mt-3 mb-2">
    <h2 class="mb-0">Rooms status and guest names</h2>
    <div>
        <a asp-action="Dashboard" class="btn btn-outline-primary">Dashboard</a>
    </div>
</div>

<!-- rows summary -->
<p id="rowsCount" class="text-muted mb-2">
    <!-- will be filled by JS -->
</p>

<table id="roomsTable" class="table table-striped table-bordered align-middle">
    <thead>
        <!-- main header row (click to sort) -->
        <tr class="main-header">
            <th>Room number</th>
            <th>Type</th>
            <th>Occupancy status</th>
            <th>Room status</th>
            <th>Guest name</th>
            <th>Details</th>
        </tr>
        <!-- filters row -->
        <tr class="filters-row">
            <!-- Room number: text search -->
            <th>
                <input type="text"
                       class="form-control form-control-sm column-filter"
                       placeholder="Search room #"
                       data-column="0" />
            </th>

            <!-- Type: combobox -->
            <th>
                <select class="form-select form-select-sm column-filter"
                        data-column="1">
                    <option value="">All</option>
                    @foreach (var t in roomTypes)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </th>

            <!-- Occupancy status: combobox -->
            <th>
                <select class="form-select form-select-sm column-filter"
                        data-column="2">
                    <option value="">All</option>
                    <option value="Occupied">Occupied</option>
                    <option value="Vacant">Vacant</option>
                    <option value="Unknown">Unknown</option>
                </select>
            </th>

            <!-- Room status: combobox -->
            <th>
                <select class="form-select form-select-sm column-filter"
                        data-column="3">
                    <option value="">All</option>
                    <option value="Clean">Clean</option>
                    <option value="Dirty">Dirty</option>
                    <option value="Clean (Inspected)">Clean (Inspected)</option>
                    <option value="Unknown">Unknown</option>
                </select>
            </th>

            <!-- Guest name: text search -->
            <th>
                <input type="text"
                       class="form-control form-control-sm column-filter"
                       placeholder="Search guest"
                       data-column="4" />
            </th>

            <!-- Details: no filter -->
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderBy(m => m.RoomNumber)) @* sorted ascending *@
        {
            <tr>
                <td>@item.RoomNumber</td>
                <td>@(string.IsNullOrWhiteSpace(item.RoomType) ? "—" : item.RoomType)</td>
                <td>@item.OccupancyStatus</td>
                <td>@item.RoomStatus</td>
                <td>
                    @if (string.IsNullOrWhiteSpace(item.GuestName))
                    {
                        @:—
                    }
                    else
                    {
                        @item.GuestName
                    }
                </td>
                <td class="text-nowrap">
                  
                    <button type="button"
                            class="btn btn-sm btn-primary js-guest"
                            data-room="@item.RoomNumber"
                            data-bs-toggle="modal"
                            data-bs-target="#guestModal">
                        Guest details
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal: Guest details -->
<!-- Modal: Guest details -->
<!-- Modal: Guest details -->
<div class="modal fade" id="guestModal" tabindex="-1" aria-labelledby="guestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="guestModalLabel">Guest details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="guest-loading" class="text-center py-4">Loading...</div>

                <div id="guest-content" class="d-none">
                    <!-- room header -->
                    <div class="mb-3">
                        <div><strong>Room:</strong> <span id="gd-room"></span></div>
                        <div><strong>Type:</strong> <span id="gd-type"></span></div>
                        <div><strong>Status:</strong> <span id="gd-status"></span></div>
                    </div>

                    <!-- guests list -->
                    <div id="gd-guests-list"></div>
                </div>

                <div id="guest-empty" class="text-center py-4 d-none">No data available.</div>
                <div id="guest-error" class="text-center text-danger py-4 d-none">An error occurred while loading data.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {

    <script>
        /* Guest modal AJAX – show guests as list */
        (function(){
            const modal = document.getElementById('guestModal');
            const loading = document.getElementById('guest-loading');
            const content = document.getElementById('guest-content');
            const empty   = document.getElementById('guest-empty');
            const error   = document.getElementById('guest-error');
            const guestsList = document.getElementById('gd-guests-list');

            function show(section){
                loading.classList.add('d-none');
                content.classList.add('d-none');
                empty.classList.add('d-none');
                error.classList.add('d-none');
                section.classList.remove('d-none');
            }

            modal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const room = button.getAttribute('data-room');
                document.getElementById('guestModalLabel').innerText =
                    `Guest details - room ${room}`;

                show(loading);

                fetch(`/Rooms/GuestDetails?id=${encodeURIComponent(room)}`)
                    .then(r => {
                        if (!r.ok) throw new Error('HTTP ' + r.status);
                        return r.json();
                    })
                    .then(d => {
                        if (!d || !Array.isArray(d.guests) || d.guests.length === 0) {
                            show(empty);
                            return;
                        }

                        // room info
                        document.getElementById('gd-room').innerText =
                            d.roomNumber ?? '';
                        document.getElementById('gd-type').innerText =
                            d.roomType || '—';
                        document.getElementById('gd-status').innerText =
                            `${d.occupancyStatus ?? ''} / ${d.roomStatus ?? ''}`.trim();

                        // build guests list
                        guestsList.innerHTML = '';
                        d.guests.forEach((g, index) => {
                            const card = document.createElement('div');
                            card.className = 'border rounded p-2 mb-2';

                            const title = document.createElement('div');
                            title.className = 'fw-bold mb-1';
                            title.textContent = `Guest ${index + 1}`;
                            card.appendChild(title);

                            function addLine(label, value) {
                                const line = document.createElement('div');
                                const text = (value && value.toString().trim())
                                    ? value
                                    : '—';
                                line.innerHTML = `<strong>${label}:</strong> ${text}`;
                                card.appendChild(line);
                            }

                            addLine('Name', g.guestName);
                            addLine('Reservation', g.reservationNo);
                            addLine('Arrival', g.arrivalDate);
                            addLine('Departure', g.departureDate);
                            addLine('Nationality', g.nationalityCode);
                            addLine('Phone', g.phone);

                            guestsList.appendChild(card);
                        });

                        show(content);
                    })
                    .catch(_ => {
                        show(error);
                    });
            });
        })();
    </script>





    <script>
        /* Header sorting + per-column filtering (inputs + selects) + row count */
        (function() {
            const table = document.getElementById('roomsTable');
            if (!table) return;

            const tbody = table.querySelector('tbody');
            const allRows = Array.from(tbody.rows); // original rows
            const totalCount = allRows.length;
            const rowsCountLabel = document.getElementById('rowsCount');

            let currentSortColumn = 0;      // default sort by room number
            let currentSortDirection = 'asc';
            const filters = {};             // { columnIndex: lowercaseFilterValue }

            function updateRowsCount(filteredCount) {
                if (!rowsCountLabel) return;
                rowsCountLabel.textContent =
                    `Showing ${filteredCount} of ${totalCount} rooms`;
            }

            function applyFiltersAndSort() {
                // Filter
                let rows = allRows.filter(row => {
                    return Object.entries(filters).every(([colIndex, value]) => {
                        const idx = parseInt(colIndex, 10);
                        const cellText = (row.cells[idx]?.textContent || '').toLowerCase();
                        return cellText.includes(value);
                    });
                });

                // Sort
                if (currentSortColumn != null) {
                    rows.sort((a, b) => {
                        const aText = (a.cells[currentSortColumn]?.textContent || '').trim();
                        const bText = (b.cells[currentSortColumn]?.textContent || '').trim();

                        let result;
                        if (currentSortColumn === 0) {
                            // numeric sort for room number
                            const aNum = parseInt(aText, 10) || 0;
                            const bNum = parseInt(bText, 10) || 0;
                            result = aNum - bNum;
                        } else {
                            result = aText.localeCompare(bText);
                        }

                        return currentSortDirection === 'asc' ? result : -result;
                    });
                }

                // Re-render tbody
                tbody.innerHTML = '';
                rows.forEach(r => tbody.appendChild(r));

                // update counts
                updateRowsCount(rows.length);
            }

            // Click header to sort
            const headerCells = table.querySelectorAll('thead tr.main-header th');
            headerCells.forEach((th, index) => {
                if (index === headerCells.length - 1) {
                    // skip Details column
                    return;
                }
                th.style.cursor = 'pointer';
                th.addEventListener('click', () => {
                    if (currentSortColumn === index) {
                        currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
                    } else {
                        currentSortColumn = index;
                        currentSortDirection = 'asc';
                    }
                    applyFiltersAndSort();
                });
            });

            // Inputs + selects for filtering
            const filterControls = table.querySelectorAll('.column-filter');
            filterControls.forEach(ctrl => {
                const col = parseInt(ctrl.dataset.column, 10);

                function updateFilter() {
                    const val = (ctrl.value || '').trim().toLowerCase();
                    if (val) {
                        filters[col] = val;
                    } else {
                        delete filters[col];
                    }
                    applyFiltersAndSort();
                }

                ctrl.addEventListener('input', updateFilter);
                ctrl.addEventListener('change', updateFilter);
            });

            // initial render (so label shows "Showing total of total rooms")
            applyFiltersAndSort();
        })();
    </script>
}
